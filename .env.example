# Rasa service
PORT=5005
ACTION_ENDPOINT_URL=https://your-actions-service.up.railway.app/webhook
RASA_TELEMETRY_ENABLED=false

# Action service: local SQL Server defaults
BUDDYBOT_DB_DIALECT=sqlserver
BUDDYBOT_DB_DRIVER=ODBC Driver 17 for SQL Server
BUDDYBOT_DB_SERVER=host.docker.internal
BUDDYBOT_DB_NAME=FCI_UNIVERSITY
BUDDYBOT_SQL_ENGINE_URL=http://host.docker.internal:8010/query
BUDDYBOT_DISABLE_SQL_ENGINE=0
CHROMA_PATH=/app/chroma_db

# Supabase/PostgreSQL deployment alternative
# Set BUDDYBOT_DB_DIALECT=postgres and fill these in Railway/Render.
# BUDDYBOT_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
# BUDDYBOT_DISABLE_SQL_ENGINE=1
# DB_HOST=db.xxxx.supabase.co
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD
# DB_PORT=5432
# DB_SSLMODE=require
